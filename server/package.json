{
  "name": "merqanta-server",
  "version": "1.0.0",
  "description": "Merqanta - Commerce Intelligence Backend REST API with Prisma ORM",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "admin:provision": "node scripts/provision-admin.js",
    "test": "node --test test/**/*.test.js",
    "db:switch:supabase": "node scripts/switch-db.js supabase",
    "db:switch:local": "node scripts/switch-db.js local"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
