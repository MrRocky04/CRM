# ==============================================================================
# WooCommerce CRM Environment Configuration Template
# ==============================================================================

# Database Configuration (Supabase Database / PostgreSQL)
# For Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# For local zero-config development/testing without live Supabase credentials:
DATABASE_URL="file:./dev.db"

# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET="change-this-to-a-very-secure-random-string-at-least-32-chars"
CORS_ORIGIN="http://localhost:5173"

# WooCommerce REST API v3 & Webhook Configuration
WOOCOMMERCE_STORE_URL="https://example.com"
WOOCOMMERCE_CONSUMER_KEY="ck_0123456789abcdef0123456789abcdef01234567"
WOOCOMMERCE_CONSUMER_SECRET="cs_0123456789abcdef0123456789abcdef01234567"
WOOCOMMERCE_WEBHOOK_SECRET="whsec_woocommerce_sample_key"

# Resend Transactional Email Configuration
RESEND_API_KEY="re_sample_api_key_for_testing"
EMAIL_FROM="WooCommerce CRM <crm@example.com>"
RESEND_WEBHOOK_SECRET="whsec_sample_resend_signing_secret"

# Initial Administrator Provisioning (used by `npm run admin:provision`)
ADMIN_EMAIL="admin@crm.local"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="CRM Administrator"

# Workflow Scheduler and Inactivity Thresholds
WORKFLOW_SCHEDULER_INTERVAL_MS=60000
ENABLE_AUTO_EMAIL=false
INACTIVE_DAYS_THRESHOLD=60
LOYAL_ORDER_COUNT_THRESHOLD=5
REPEAT_ORDER_COUNT_THRESHOLD=2
